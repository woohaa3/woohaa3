{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WooHaa3",
  "mainBinaryName": "woohaa-desktop",
  "version": "0.1.21",
  "identifier": "com.woohaa.desktop",
  "build": {
    "frontendDist": "../web/frontend/dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "vendor/photocraft/LICENSE-MIT": "licenses/photocraft/LICENSE-MIT",
      "vendor/photocraft/LICENSE-APACHE": "licenses/photocraft/LICENSE-APACHE",
      "vendor/photocraft/NOTICE": "licenses/photocraft/NOTICE",
      "vendor/photocraft/ATTRIBUTION.md": "licenses/photocraft/ATTRIBUTION.md",
      "vendor/photocraft/assets/app-icon/LICENSE.txt": "licenses/photocraft/assets/app-icon/LICENSE.txt",
      "vendor/photocraft/assets/dict/LICENSE-SCOWL.txt": "licenses/photocraft/assets/dict/LICENSE-SCOWL.txt",
      "vendor/photocraft/assets/fonts/OFL-Inter.txt": "licenses/photocraft/assets/fonts/OFL-Inter.txt",
      "vendor/photocraft/assets/fonts/OFL-JetBrainsMono.txt": "licenses/photocraft/assets/fonts/OFL-JetBrainsMono.txt",
      "vendor/photocraft/assets/icons/LICENSE-lucide.txt": "licenses/photocraft/assets/icons/LICENSE-lucide.txt",
      "vendor/photocraft/assets/icons/LICENSE-noun-magnetic-lasso.txt": "licenses/photocraft/assets/icons/LICENSE-noun-magnetic-lasso.txt",
      "vendor/photocraft/assets/icons/LICENSE-symmetry-axes.txt": "licenses/photocraft/assets/icons/LICENSE-symmetry-axes.txt",
      "vendor/photocraft/crates/algo/data/LICENSE-libfacedetection.txt": "licenses/photocraft/crates/algo/data/LICENSE-libfacedetection.txt",
      "vendor/photocraft/crates/ui-egui/src/LICENSE-solarized.txt": "licenses/photocraft/crates/ui-egui/src/LICENSE-solarized.txt",
      "vendor/photocraft/crates/ui-egui/src/i18n/LICENSE-translations.txt": "licenses/photocraft/crates/ui-egui/src/i18n/LICENSE-translations.txt"
    },
    "category": "GraphicsAndDesign",
    "shortDescription": "画布式多媒体创作工作台：在同一画布组织、生成与编辑素材。",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
