{
  "name": "@woohaa3/extension-creature-video-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "画布内的生物资产八步制作与逐版本验收。",
  "exports": {
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "import": "./dist/frontend.js"
    },
    "./backend-extension": {
      "types": "./src/backend-extension.ts",
      "import": "./dist/backend-extension.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./dist/shared.js"
    }
  },
  "scripts": {
    "build": "node ../../web/scripts/build-package.mjs --entry src/shared.ts --entry-name shared --outdir dist --platform neutral && node ../../web/scripts/build-package.mjs --entry src/frontend/index.ts --entry-name frontend --outdir dist --platform browser && node ../../web/scripts/build-package.mjs --entry src/backend-extension.ts --entry-name backend-extension --outdir dist --platform node && node tools/build-production.mjs",
    "build:browser": "node ../../web/scripts/build-extension-browser.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tools:doctor": "node tools/doctor.mjs",
    "tools:bootstrap": "node tools/bootstrap.mjs"
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/frontend": "workspace:*",
    "jszip": "3.10.1",
    "react": "^18.3.1",
    "sharp": "0.35.4",
    "three": "0.170.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "esbuild": "^0.21.5",
    "jsdom": "^30.1.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "browser-dist",
    "src",
    "python",
    "defaults",
    "tools",
    "extension.json",
    "SOURCE.md",
    "migration-manifest.json",
    "README.md"
  ]
}
