{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src", "tests"]
}
