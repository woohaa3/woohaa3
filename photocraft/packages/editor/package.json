{
  "name": "@woohaa3/photocraft-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PhotoCraft React 编辑器：工具/图层/样式/文字/选区界面与内核会话控制器。只经端口依赖宿主。",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./styles.css": "./src/photo-editor.css",
    "./wasm": {
      "types": "./src/wasm.d.ts",
      "import": "./dist/wasm/photocraft_editor.js"
    },
    "./ui/styles.css": "./src/ui/primitives.css",
    "./ui/forms.css": "./src/ui/form-controls.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@woohaa3/photocraft-protocol": "link:../protocol",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
