{
  "name": "@woohaa3/photocraft-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PhotoCraft 独立子项目工作区：纯协议、React 编辑器、Node 工程核验与独立开发宿主。",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./dev\" run build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./dev\" run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "dev": "pnpm -C dev dev",
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:debug": "node scripts/build-wasm.mjs --debug",
    "wasm:smoke": "node tests/wasm-interactions.mjs",
    "verifier": "node scripts/build-verifier.mjs",
    "verifier:debug": "node scripts/build-verifier.mjs --debug",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace --offline",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --workspace --offline",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3"
  }
}
