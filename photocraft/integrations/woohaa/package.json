{
  "name": "@woohaa3/photocraft-woohaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PhotoCraft 的 Woohaa 适配包：frontend 插件、聚焦工作区、旧标注转换、保存回执与标注栅格化。宿主只提供公共平台端口。",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./test-support": {
      "types": "./src/test-support/photo-editor-harness.tsx",
      "import": "./src/test-support/photo-editor-harness.tsx"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/frontend": "workspace:*",
    "@woohaa3/photocraft-editor": "link:../../packages/editor",
    "@woohaa3/photocraft-protocol": "link:../../packages/protocol",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
