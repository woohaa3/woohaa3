{
  "name": "@woohaa3/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 统一后端运行单元（change: 2026-10-06-unify-backend-runtime-with-cordis）：同一进程内组合 Canvas/Task/Media/MCP/站点插件宿主，并提供后端 Cordis 运行时与 ctx.generation 生成扩展点。",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../scripts/build-package.mjs --platform node && pnpm run build:extension-host-child",
    "build:extension-host-child": "node scripts/build-extension-host-child.mjs",
    "server:build": "node ../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@sdppp/pptask": "workspace:*",
    "@woohaa3/application-service": "workspace:*",
    "@woohaa3/canvas-service": "workspace:*",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/provider-sdk": "workspace:*",
    "@woohaa3/extension-local-agent": "workspace:*",
    "@woohaa3/extension-oauth-agent": "workspace:*",
    "@woohaa3/extension-sdk-agent": "workspace:*",
    "@woohaa3/mcp-service": "workspace:*",
    "@woohaa3/media-service": "workspace:*",
    "@woohaa3/task-service": "workspace:*",
    "@woohaa3/telemetry-service": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "@woohaa3/runtime-components": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@woohaa3/extension-sample-site": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
