{
  "name": "@woohaa3/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 \u7edf\u4e00\u540e\u7aef\u8fd0\u884c\u5355\u5143\uff08change: 2026-10-06-unify-backend-runtime-with-cordis\uff09\uff1a\u540c\u4e00\u8fdb\u7a0b\u5185\u7ec4\u5408 Canvas/Task/Media/MCP/\u7ad9\u70b9\u63d2\u4ef6\u5bbf\u4e3b\uff0c\u5e76\u63d0\u4f9b\u540e\u7aef Cordis \u8fd0\u884c\u65f6\u4e0e ctx.generation \u751f\u6210\u6269\u5c55\u70b9\u3002",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../scripts/build-package.mjs --platform node",
    "server:build": "node ../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@woohaa3/application-service": "workspace:*",
    "@woohaa3/canvas-service": "workspace:*",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/extension-local-agent": "workspace:*",
    "@woohaa3/extension-oauth-agent": "workspace:*",
    "@woohaa3/extension-sdk-agent": "workspace:*",
    "@woohaa3/mcp-service": "workspace:*",
    "@woohaa3/media-service": "workspace:*",
    "@woohaa3/task-service": "workspace:*",
    "@woohaa3/telemetry-service": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@woohaa3/extension-sample-site": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
