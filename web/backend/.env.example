# 统一后端运行单元服务端环境
# （change: 2026-10-06-unify-backend-runtime-with-cordis）
#
# 后端在同一进程内组合 Canvas/Task/Media/MCP 与站点插件宿主。浏览器绝不持有这些凭据；
# 复制为客户端仓库的 `client/web/.env` 或经部署侧注入；不要带 VITE_ 前缀。

# --- 应用挂载路径（change: 2026-10-15-support-configurable-app-base-path）---
# 未设置/空/`/` 表示根路径；子路径如 `/canvas/`、`/tools/woohaa/`（路径段只允许 [A-Za-z0-9_-]）。
# 非法值在监听端口前报错退出。反向代理必须保留完整前缀转发。
WOOHAA3_BASE_PATH=

# --- 各领域模块的 durable store（同一进程，各自独立库） ---
WOOHAA3_TASK_STORE_PATH=./.data/task.sqlite
WOOHAA3_CANVAS_STORAGE_BACKEND=sqlite
WOOHAA3_CANVAS_STORAGE_SQLITE_PATH=./.data/canvas.sqlite
WOOHAA3_APPLICATION_STORE_PATH=./.data/application.sqlite

# --- 媒体存储（COS）：只由 backend 进程内的 Media 模块读取 ---
# 单进程后不再有独立 Media 进程，但 COS 凭据仍只在 Media 模块内使用（代码级边界）。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
COS_BUCKET_URL=
COS_PREFIX=

# --- Provider 凭据：只由 backend 进程内的生成/provider 模块读取 ---
# 面板（浏览器）凭据优先于这里的部署环境变量；环境变量作为无面板时的兼容路径。
# RunningHub API：只填 apiKey（地址由插件固定），可选环境变量兼容路径。
RUNNINGHUB_API_KEY=
ARK_VIDEO_API_KEY=
ARK_VIDEO_SEEDANCE2_0_MODEL=
ARK_VIDEO_SEEDANCE2_5_MODEL=

# --- 站点插件管理面认证（可选） ---
WOOHAA3_APPLICATION_ADMIN_TOKEN=
WOOHAA3_APPLICATION_AUTH_ADAPTER=disabled
WOOHAA3_APPLICATION_AUTH_SHARED_SECRET=

# --- 本地开发 ---
WOOHAA3_MCP_DEVELOPMENT_PRINCIPAL=
WOOHAA3_AGENT_LOOPBACK_MODE=
WOOHAA3_MODELS_CONFIG_PATH=

HOST=127.0.0.1
# 统一后端进程端口（生产入口 serve-web 默认监听 PORT，同进程内装配后端）。
BACKEND_PORT=5180
