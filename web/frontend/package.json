{
  "name": "@woohaa3/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器运行时单元：画布宿主、Godot bridge、任务面板与全局历史页（change: split-web-runtime-services）。",
  "exports": {
    "./extension-api": {
      "types": "./src/extension-api/index.ts",
      "import": "./src/extension-api/index.ts"
    },
    "./plugin-api": {
      "types": "./src/plugin-api/index.ts",
      "import": "./src/plugin-api/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:desktop": "tsc -b && vite build --mode desktop"
  },
  "dependencies": {
