{
  "name": "@woohaa3/extension-sdk-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "四类 API 的固定 Agent 框架运行时；按 owner/连接隔离 API Key 与执行上下文。",
  "exports": {
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "import": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./src/backend/index.ts",
      "import": "./dist/backend.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./dist/shared.js"
    }
  },
  "files": [
    "dist",
    "browser-dist",
    "src",
    "extension.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --entry src/frontend/index.ts --outdir dist --platform browser --entry-name frontend && node ../../scripts/build-package.mjs --entry src/backend/index.ts --outdir dist --platform node --entry-name backend && node ../../scripts/build-package.mjs --entry src/shared.ts --outdir dist --platform neutral --entry-name shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:browser": "node ../../scripts/build-extension-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "^0.135.0",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@google/adk": "2.3.0",
    "@openai/codex-sdk": "0.161.0",
    "@woohaa3/agent-connections": "workspace:*",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/frontend": "workspace:*",
    "react": "^18.3.1",
    "@woohaa3/runtime-components": "workspace:*",
    "@woohaa3/ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
