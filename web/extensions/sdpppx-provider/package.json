{
  "name": "@woohaa3/extension-sdpppx-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDPPPX 接入：宿主侧微信扫码登录、租户模板生成 Provider、参考素材上传与异步任务。",
  "exports": {
    "./frontend": {
      "types": "./src/frontend/index.ts",
      "import": "./dist/frontend.js"
    },
    "./backend": {
      "types": "./src/backend.ts",
      "import": "./dist/backend.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./dist/shared.js"
    }
  },
  "files": [
    "dist",
    "backend-dist",
    "browser-dist",
    "assets",
    "src",
    "extension.json"
  ],
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:backend",
    "build:node": "node ../../scripts/build-package.mjs --entry src/frontend/index.ts --outdir dist --platform browser --entry-name frontend && node ../../scripts/build-package.mjs --entry src/backend.ts --outdir dist --platform node --entry-name backend && node ../../scripts/build-package.mjs --entry src/shared.ts --outdir dist --platform neutral --entry-name shared",
    "build:backend": "node ../../scripts/build-extension-backend.mjs",
    "build:browser": "node ../../scripts/build-extension-browser.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdppp/pptask": "workspace:*",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/frontend": "workspace:*",
    "@woohaa3/provider-sdk": "workspace:*",
    "@woohaa3/ui": "workspace:*",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
