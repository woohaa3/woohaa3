{
  "schemaVersion": 1,
  "extensionId": "runninghub-provider",
  "site": {
    "name": "RunningHub",
    "description": "RunningHub 模型 API、文字模型与临时图床；账户余额在模型提供商列表行内展示。",
    "version": "2.2.0",
    "configSchema": { "schemaId": "runninghub-provider-config", "schemaVersion": 1 },
    "capabilities": [
      { "id": "runninghub.balance", "kind": "handler", "description": "读取当前 RunningHub 账户余额", "auth": "authenticated" }
    ],
    "defaultEnabled": true,
    "order": 20
  },
  "metadata": { "module": "./shared", "export": "RUNNINGHUB_PLUGIN_METADATA", "order": 30 },
  "hostPlugin": { "module": "./backend", "factory": "createRunningHubProviderPlugin", "features": ["provider"], "order": 20 },
  "icon": { "asset": "./assets/icon.png" },
  "version": "2.2.0"
}
