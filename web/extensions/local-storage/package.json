{
  "name": "@woohaa3/extension-local-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地对象存储后端插件：向 ctx.storage 注册 backendId=local 的本地文件后端（无 presign，缺省主存储），可选注册公开临时桶提供者（local-public）。",
  "exports": {
    "./backend": {
      "types": "./src/backend.ts",
      "import": "./dist/backend.js"
    }
  },
  "files": [
    "dist",
    "src",
    "extension.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --entry src/backend.ts --outdir dist --platform node --entry-name backend",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*",
    "cos-nodejs-sdk-v5": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
