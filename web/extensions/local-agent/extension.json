{
  "schemaVersion": 1,
  "extensionId": "local-agent",
  "site": {
    "name": "本地 agent",
    "description": "连接运行本应用的电脑上的本地 ChatGPT / 本地 OpenCode / 本地 CodeBuddy（默认关闭，线上默认不安装）。",
    "version": "0.1.0",
    "configSchema": { "schemaId": "local-agent-config", "schemaVersion": 1 },
    "capabilities": [
      { "id": "agent-connection-provider:local-agent", "kind": "capability", "description": "本地 agent 连接发现" }
    ],
    "defaultEnabled": false,
    "order": 70
  },
  "backend": { "module": "./backend", "factory": "createLocalAgentExtension", "optionsType": "LocalAgentExtensionOptions", "order": 70 },
  "publicRoutes": [
    {
      "publicPath": "/api/local-agent",
      "route": "local-agent",
      "methods": ["GET", "POST"]
    }
  ]
}
