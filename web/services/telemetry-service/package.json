{
  "name": "@woohaa3/telemetry-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 Telemetry Service — 本机遥测的归一、SQLite 落库与保留清理、窗口聚合、确定性异常规则与复盘 HTTP 读面。Public /api/telemetry/* intake/query/clear/status; exports are pluggable and default off.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --platform node",
    "watch": "node ../../scripts/build-package.mjs --platform node --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
