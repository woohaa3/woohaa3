{
  "name": "@woohaa3/canvas-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 Canvas Service — the single canvas authority: domain, commands, SQLite/Mongo storage, Yjs room/WebSocket, task run/cancel, projection from Task history and Media/Task protocol clients.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --platform node",
    "server:build": "node ../../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@woohaa3/contracts": "workspace:*",
    "mongodb": "^6.12.0",
    "quickjs-emscripten": "0.31.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.32",
    "@woohaa3/runtime-components": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.13",
    "@woohaa3/extension-film-set": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
