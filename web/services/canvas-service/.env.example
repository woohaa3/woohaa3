# Canvas Service 配置示例。
#
# 只包含**画布权威**所需配置：画布数据库与 Yjs 同步，以及到 Task/Media 的服务地址与
# 服务身份令牌。**不含** `COS_*`（那属于 Media Service）与 provider 凭据（属于 Task Service）。
#
# 缺任一必需项时启动 fail-fast，且不启用任何回退（不回落内存、本地文件或另一 backend）。

# 画布数据库（必须显式选择 backend）。
WOOHAA3_CANVAS_STORAGE_BACKEND=sqlite
# sqlite profile：
WOOHAA3_CANVAS_STORAGE_SQLITE_PATH=./.local/canvas.sqlite
# mongo profile（二选一）：
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MONGODB_DB=woohaa3

# 限制（可选）。
# WOOHAA3_CANVAS_STORAGE_MAX_JSON_BYTES=8388608
# WOOHAA3_CANVAS_STORAGE_MAX_COMMANDS=512

# 访问边界：监听非 loopback 时必须配置服务令牌。
# WOOHAA3_CANVAS_STORAGE_SERVICE_TOKEN=
# WOOHAA3_CANVAS_STORAGE_LISTEN_HOST=127.0.0.1

# 下游服务地址（内部协议；不暴露公网）。
WOOHAA3_TASK_SERVICE_URL=http://127.0.0.1:5182
WOOHAA3_MEDIA_SERVICE_URL=http://127.0.0.1:5181

# MCP Service 调用 Canvas 内部协议时的服务身份令牌（change: split-model-mcp-into-mcp-service）。
# 未配置时回退到 WOOHAA3_CANVAS_STORAGE_SERVICE_TOKEN，或仅允许 loopback。
# WOOHAA3_MCP_TO_CANVAS_TOKEN=

# 监听。
CANVAS_SERVICE_PORT=5183
CANVAS_SERVICE_HOST=127.0.0.1

# Agent Canvas authoring（change: add-agent-canvas-authoring-mcp）。
#
# development principal：仅 loopback 本地开发；生产必须由 ingress 注入认证 principal。
# 配置它时必须同时设置 WOOHAA3_AGENT_LOOPBACK_MODE=1，否则 readiness 失败（生产配置校验）。
# WOOHAA3_MCP_DEVELOPMENT_PRINCIPAL=local-agent
# WOOHAA3_AGENT_LOOPBACK_MODE=1
