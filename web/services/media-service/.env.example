# Media Service 配置示例。
#
# 媒体服务不直接持有对象存储：字节读写与「取外部地址」由宿主经 `ctx.storage` 的 media
# namespace 注入（后端是 local、COS 还是服务端由宿主设置 `storage.primary` / `storage.expose`
# 决定）。存储凭据属于对应存储后端插件，见 web/extensions/cos-storage。

# 服务身份：内部 verify/sign/import 只接受受信任服务令牌。
# Canvas 身份只允许 verify；Task 身份允许 verify/sign/import。
WOOHAA3_CANVAS_SERVICE_TOKEN=
WOOHAA3_TASK_SERVICE_TOKEN=

# 监听。
MEDIA_SERVICE_PORT=5181
MEDIA_SERVICE_HOST=127.0.0.1
