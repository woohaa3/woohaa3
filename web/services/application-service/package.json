{
  "name": "@woohaa3/application-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 Application Service — 站点同源入口 + 公共 Context + 可信插件后端宿主 + 站点插件控制面。通过受认证网络协议调用 Canvas/Task/Media。",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --platform node",
    "server:build": "node ../../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@woohaa3/extension-sample-site": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
