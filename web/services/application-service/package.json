{
  "name": "@woohaa3/application-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 Application Service \u2014 \u7ad9\u70b9\u540c\u6e90\u5165\u53e3 + \u516c\u5171 Context + \u53ef\u4fe1\u63d2\u4ef6\u540e\u7aef\u5bbf\u4e3b + \u7ad9\u70b9\u63d2\u4ef6\u63a7\u5236\u9762\u3002\u901a\u8fc7\u53d7\u8ba4\u8bc1\u7f51\u7edc\u534f\u8bae\u8c03\u7528 Canvas/Task/Media\u3002",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --platform node",
    "server:build": "node ../../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*",
    "mongodb": "^6.12.0",
    "woohaa3-executor": "workspace:*"
  },
  "devDependencies": {
    "@woohaa3/extension-sample-site": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
