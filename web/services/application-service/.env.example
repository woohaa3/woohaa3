# Application Service 服务端环境（change: 2026-10-05-extract-application-plugin-host）
#
# 站点插件配置权威、可信认证与公共 Context 由本服务持有。浏览器绝不持有这些令牌。
# 复制为仓库 `web/.env` 或经部署侧注入；不要带 VITE_ 前缀。

# durable store 路径（站点配置、revision、审计、工作引用与提交意图）
WOOHAA3_APPLICATION_STORE_PATH=./.data/application.sqlite

# 服务间身份：Application -> Canvas/Task/Media 的内部调用令牌
WOOHAA3_APPLICATION_SERVICE_TOKEN=

# 直接管理面 bearer（可选）：仅用于受控运维；优先于认证适配器
WOOHAA3_APPLICATION_ADMIN_TOKEN=

# 可信认证适配器：disabled（默认，管理写入拒绝）或 shared-secret
WOOHAA3_APPLICATION_AUTH_ADAPTER=disabled
WOOHAA3_APPLICATION_AUTH_SHARED_SECRET=

# 领域服务地址（不配置时对应能力拒绝，不做内存回退）
WOOHAA3_CANVAS_SERVICE_URL=http://127.0.0.1:5183
WOOHAA3_TASK_SERVICE_URL=http://127.0.0.1:5182
WOOHAA3_MEDIA_SERVICE_URL=http://127.0.0.1:5181

PORT=5185
HOST=127.0.0.1
