{
  "name": "@woohaa3/task-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 Task Service — durable pptask execution: provider catalog, idempotent submit/cancel, claim/lease, retry/recovery, persisted status/history and the read-only browser history API.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs --platform node",
    "server:build": "node ../../scripts/build-package.mjs --platform node --entry src/server.ts --outdir server-dist",
    "watch": "node ../../scripts/build-package.mjs --platform node --watch",
    "start": "node server-dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdppp/pptask": "workspace:*",
    "@sdppp/pptask-worker-server": "workspace:*",
    "@woohaa3/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0",
    "ai": "^7.0.99",
    "@ai-sdk/provider": "^4.0.14"
  }
}
