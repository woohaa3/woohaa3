# Task Service 配置示例。
#
# 只包含**任务执行**所需配置：provider 凭据、durable task/history store、Media Service 地址
# 与服务身份、保留策略。**不含** `COS_*`（属于 Media Service）与画布数据库配置（属于 Canvas）。

# provider 凭据；只允许在服务端，绝不使用会进浏览器 bundle 的 `VITE_*` 前缀。
# 新变量（与参考仓库一致）：
LITELLM_API_KEY=
LITELLM_BASE_URL=
# 迁移期兼容别名（一个发布周期）；冲突时上面的 LITELLM_* 优先。
# PPTASK_LITELLM_API_KEY=
# PPTASK_LITELLM_BASE_URL=

# 可选 Provider（未配置则对应资源不出现在 catalog）：
# 原生 Gemini（LiteLLM 不可用时的 fallback）
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# Kino（图片；test-login 配置齐全时才启用）
# KINO_BASE_URL=
# KINO_TEST_KEY=
# KINO_TEST_OPEN_ID=
# KINO_GAME_ID=
# Anthropic（文本）
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Ark（视频 Seedance / 图片 Seedream / 文本 doubao）
# ARK_VIDEO_API_KEY=
# ARK_VIDEO_GENERATION_URL=
# ARK_VIDEO_TASK_URL=
# ARK_VIDEO_SEEDANCE2_0_MODEL=
# ARK_VIDEO_SEEDANCE2_5_MODEL=
# ARK_IMAGE_API_KEY=
# ARK_IMAGE_GENERATION_URL=
# ARK_IMAGE_SEEDREAM_5_PRO_MODEL=
# ARK_IMAGE_SEEDREAM_4_5_MODEL=
# ARK_TEXT_GENERATION_URL=

# durable task/history store（SQLite 文件；不得复用 Canvas 数据库）。
# SQLite profile 只支持单 Task Service 进程 + 单 dispatcher；多实例部署必须替换
# durable backend 与 notification transport，并把下面的 MULTI_INSTANCE 关掉/移除。
WOOHAA3_TASK_STORE_PATH=./.local/task-service.sqlite
# WOOHAA3_TASK_MULTI_INSTANCE=true   # 显式为多实例部署 → 本 profile 启动失败

# 调度（change: replace-worker-db-polling-with-dispatcher）。
# 正常路径由 durable commit / capacity release / retry deadline 事件驱动，不做空闲轮询。
# 并发默认 2000，且准入上限为 2000（超过即封顶）。
WOOHAA3_TASK_WORKER_CONCURRENCY=2000          # dispatcher 并发容量（默认 2000，上限 2000）
WOOHAA3_TASK_LEASE_MS=120000               # active claim 租约；heartbeat 按 lease/3 续租
# 低频、带抖动的 recovery sweep（安全网）：补偿通知丢失、timer 丢失与过期 lease。
# 有安全下限（≥5000ms），远高于旧 100ms 轮询；默认 30000ms。
WOOHAA3_TASK_RECOVERY_INTERVAL_MS=30000
WOOHAA3_TASK_RECOVERY_JITTER_MS=5000
# 优雅停机等待 active executor 的有界宽限；超时后 abort 上游 drive。
WOOHAA3_TASK_SHUTDOWN_GRACE_MS=30000

# 服务身份（受信任代理/内部调用）。
WOOHAA3_TASK_SERVICE_TOKEN=
# Media Service 地址（内部协议）。
WOOHAA3_MEDIA_SERVICE_URL=http://127.0.0.1:5181

# 历史保留策略。
WOOHAA3_TASK_HISTORY_RETENTION_DAYS=30
WOOHAA3_TASK_HISTORY_MAX_RECORDS=5000

# 模型配置文件路径（仓库内可评审文件；默认 ./pptask.models.json）。
# WOOHAA3_MODELS_CONFIG_PATH=/abs/path/pptask.models.json

# 监听。
TASK_SERVICE_PORT=5182
TASK_SERVICE_HOST=127.0.0.1
