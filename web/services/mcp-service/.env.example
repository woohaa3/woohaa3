# MCP Service 配置示例。
#
# 无状态 MCP 协议与编排单元：只依赖 Canvas Service 的**受认证内部协议**。它不持有画布、
# 任务或媒体权威，不含数据库、Yjs、COS 或 provider 配置。缺 Canvas 地址时 readiness
# 失败（不回退）。

# 监听。
MCP_SERVICE_PORT=5184
MCP_SERVICE_HOST=127.0.0.1

# Canvas 内部协议基地址（服务间地址，不暴露公网）。
WOOHAA3_CANVAS_SERVICE_URL=http://127.0.0.1:5183
# MCP Service 调用 Canvas 内部协议的服务身份令牌（应与 Canvas 的 WOOHAA3_MCP_TO_CANVAS_TOKEN 一致）。
# WOOHAA3_MCP_TO_CANVAS_TOKEN=
# 旧 MCP 客户端缺省画布 ID。
# WOOHAA3_DEFAULT_CANVAS_ID=woohaa3-default-canvas
# 内部协议超时（毫秒）；预览可能较慢。
# WOOHAA3_MCP_CANVAS_TIMEOUT_MS=30000

# Agent Canvas authoring（change: add-agent-canvas-authoring-mcp）。
#
# 开发 principal：仅 loopback 本地单用户开发使用；生产必须由 ingress 注入认证 principal。
# 配置它时必须同时设置 WOOHAA3_AGENT_LOOPBACK_MODE=1，否则 readiness 失败（生产配置校验）。
# WOOHAA3_MCP_DEVELOPMENT_PRINCIPAL=local-agent
# WOOHAA3_AGENT_LOOPBACK_MODE=1
