{
  "name": "@woohaa3/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared browser presentation components, styles and theme bridge.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./forms": {
      "types": "./src/forms/index.ts",
      "import": "./src/forms/index.ts"
    },
    "./dialogs": {
      "types": "./src/dialogs/index.ts",
      "import": "./src/dialogs/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "import": "./src/media/index.ts"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "import": "./src/settings/index.ts"
    },
    "./assistant": {
      "types": "./src/assistant/index.ts",
      "import": "./src/assistant/index.ts"
    },
    "./feedback": {
      "types": "./src/feedback/index.ts",
      "import": "./src/feedback/index.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "import": "./src/icons/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json && node scripts/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@types/react": { "optional": true },
    "@types/react-dom": { "optional": true }
  },
  "dependencies": {
    "@woohaa3/contracts": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@ladle/react": "^5.1.1",
    "esbuild": "^0.25.0"
  }
}
