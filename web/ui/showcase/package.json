{
  "name": "@woohaa3/ui-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ladle 组件库：共享 UI 包的独立组件状态与真实业务集成示例。",
  "scripts": {
    "dev": "ladle serve",
    "build": "ladle build",
    "preview": "ladle preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@woohaa3/ui": "workspace:*"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@woohaa3/contracts": "workspace:*",
    "@woohaa3/extension-prompt-snippets": "workspace:*",
    "@woohaa3/extension-task-activity": "workspace:*",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "@woohaa3/extension-film-set": "workspace:*"
  }
}
