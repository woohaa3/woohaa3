{
  "name": "@woohaa3/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa3 cross-runtime contracts — versioned DTOs, runtime schemas, stable error codes and side-effect-free codecs shared by frontend, canvas-service, task-service and media-service. Browser-safe: no Node drivers, COS SDK, provider SDK or Yjs server.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./canvas-yjs": {
      "types": "./src/canvas/yjs/index.ts",
      "import": "./dist/canvas-yjs/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../scripts/build-package.mjs && node ../scripts/build-package.mjs --entry src/canvas/yjs/index.ts --outdir dist/canvas-yjs --platform neutral",
    "watch": "node ../scripts/build-package.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woohaa3/photocraft-protocol": "link:../../photocraft/packages/protocol",
    "lib0": "^0.2.117",
    "yjs": "^13.6.32"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
