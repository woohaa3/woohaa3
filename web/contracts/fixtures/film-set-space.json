{
  "version": "woohaa-film-set-space-v1",
  "tolerance": 0.00001,
  "note": "片场场景空间 ↔ 画布呈现空间 fixtures（change: 2026-10-23-isolate-film-set-camera-space）。由 Web 数学生成，Rust `model3d::shot_adapter::display_camera_state` 与 `client/bevy/tests/film_set_space.rs` 断言同一数值。",
  "cases": [
    {
      "name": "identity-display",
      "display": { "scale": 1, "yaw": 0 },
      "boundsCenter": [0, 0, 0],
      "camera": { "azimuth": 0.4, "elevation": 0.7, "distance": 6.5, "focusOffset": [0, 0, 0] },
      "expected": { "distance": 6.5, "focusOffset": [0, 0, 0], "focus": [0, 0, 0] }
    },
    {
      "name": "container-shrinks-by-quarter",
      "display": { "scale": 0.25, "yaw": 0 },
      "boundsCenter": [120, -30, 40],
      "camera": { "azimuth": 0.4, "elevation": 0.7, "distance": 6.5, "focusOffset": [0, 1.2, 0] },
      "expected": { "distance": 1.625, "focusOffset": [0, 0.3, 0], "focus": [120, -29.7, 40] }
    },
    {
      "name": "container-grows-four-fold",
      "display": { "scale": 4, "yaw": 0 },
      "boundsCenter": [-8, 2.5, 16],
      "camera": { "azimuth": -2.1, "elevation": -0.3, "distance": 2.65, "focusOffset": [0.235, 1.365, -0.025] },
      "expected": { "distance": 10.6, "focusOffset": [0.94, 5.46, -0.1], "focus": [-7.06, 7.96, 15.9] }
    },
    {
      "name": "quarter-turn-display-rotation",
      "display": { "scale": 2, "yaw": 1.5707963267948966 },
      "boundsCenter": [10, 0, -10],
      "camera": { "azimuth": 0, "elevation": 0.7853982, "distance": 3, "focusOffset": [1, 0.5, 0] },
      "expected": { "distance": 6, "focusOffset": [0, 1, -2], "focus": [10, 1, -12] }
    },
    {
      "name": "non-zero-azimuth-and-depth-offset",
      "display": { "scale": 0.5, "yaw": -0.6 },
      "boundsCenter": [3, -1, 7],
      "camera": { "azimuth": 1.2, "elevation": 0.1, "distance": 12, "focusOffset": [2, -1, 3] },
      "expected": { "distance": 6, "focusOffset": [-0.021627, -0.5, 1.802646], "focus": [2.978373, -1.5, 8.802646] }
    }
  ],
  "dragCases": [
    {
      "name": "scene-distance-drag-is-scale-invariant",
      "display": { "scale": 0.25, "yaw": 0 },
      "startSceneDistance": 2.65,
      "deltaPixels": -120,
      "surfaceHeight": 720,
      "note": "场景单位手势：屏幕位移换算后仍以场景单位 clamp，世界构图缩放不影响保存值"
    }
  ]
}
