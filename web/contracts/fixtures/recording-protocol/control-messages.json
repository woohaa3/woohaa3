          "totalFrames": "90",
          "sampleTime": 0.4
        }
      }
    },
    {
      "name": "state changed to terminal",
      "expect": "accepted",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "43",
        "stateChanged": {
          "sequence": "43",
          "job": {
            "jobId": "job-1",
            "attemptId": "attempt-1",
            "executorInstanceId": "executor-1",
            "executionEpoch": "3",
            "snapshotHash": "snapshot-abc",
            "contentIdentity": "content-def",
            "profileKey": "native-v1-1280x720@30"
          },
          "state": "RECORDING_JOB_STATE_SUCCEEDED"
        }
      }
    },
    {
      "name": "unsupported protocol version",
      "expect": "rejected",
      "code": "recording-protocol-version-mismatch",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_2",
        "sequence": "1",
        "capabilityRequest": {}
      }
    },
    {
      "name": "missing protocol version",
      "expect": "rejected",
      "code": "recording-protocol-version-mismatch",
