            "contentIdentity": "content-def",
            "profileKey": "native-v1-1280x720@30"
          },
          "state": "RECORDING_JOB_STATE_FAILED",
          "error": {
            "stage": "RECORDING_ERROR_STAGE_FRAME_READY",
            "code": "capture-readiness-timeout",
