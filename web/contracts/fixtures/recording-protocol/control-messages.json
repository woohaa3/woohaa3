        "sequence": "1",
        "capabilityRequest": {}
      }
    },
    {
      "name": "two payloads in one envelope",
      "expect": "rejected",
      "code": "recording-unknown-payload",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "1",
        "capabilityRequest": {},
        "listJobs": {}
      }
    },
    {
      "name": "unknown payload name",
      "expect": "rejected",
      "code": "recording-unknown-payload",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "1",
        "teleportJob": {}
      }
    },
    {
      "name": "job scoped message without identity",
      "expect": "rejected",
      "code": "recording-identity-incomplete",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "1",
        "cancelJob": {
          "sequence": "1",
          "requestId": "req-cancel",
          "reason": "user"
        }
      }
    },
    {
      "name": "job scoped message with partial identity",
      "expect": "rejected",
      "code": "recording-identity-incomplete",
