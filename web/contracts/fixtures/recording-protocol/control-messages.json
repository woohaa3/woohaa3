{
  "$comment": "Cross-language fixtures for the recording control protocol. Consumed by bevy/src/recording_protocol.rs and web/contracts/src/canvas/recording-protocol.test.ts. Do not add cases that require a second schema.",
  "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
  "identity": {
