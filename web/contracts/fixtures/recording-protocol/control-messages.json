          "registrationNonce": "nonce"
        }
      }
    },
    {
      "name": "progress with complete identity",
      "expect": "accepted",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "42",
        "progress": {
          "sequence": "42",
          "job": {
            "jobId": "job-1",
            "attemptId": "attempt-1",
            "executorInstanceId": "executor-1",
            "executionEpoch": "3",
            "snapshotHash": "snapshot-abc",
            "contentIdentity": "content-def",
            "profileKey": "native-v1-1280x720@30"
          },
          "state": "RECORDING_JOB_STATE_RENDERING",
