        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "1",
        "cancelJob": {
          "sequence": "1",
          "requestId": "req-cancel",
          "job": { "jobId": "job-1", "attemptId": "attempt-1" },
          "reason": "user"
        }
      }
    },
    {
      "name": "unknown error stage enum",
      "expect": "rejected",
      "code": "recording-unknown-enum",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "2",
        "stateChanged": {
          "sequence": "2",
          "job": {
            "jobId": "job-1",
            "attemptId": "attempt-1",
            "executorInstanceId": "executor-1",
            "executionEpoch": "3",
            "snapshotHash": "snapshot-abc",
            "contentIdentity": "content-def",
