      }
    },
    {
      "name": "known error stage enum",
      "expect": "accepted",
      "message": {
        "protocolVersion": "RECORDING_PROTOCOL_VERSION_1_ALPHA_1",
        "sequence": "3",
        "stateChanged": {
          "sequence": "3",
          "job": {
            "jobId": "job-1",
