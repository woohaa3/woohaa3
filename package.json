{
  "name": "woohaa3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woohaa standalone desktop and browser client",
  "scripts": {
    "desktop:probe": "node scripts/desktop-native.mjs --probe",
    "desktop:check": "node scripts/desktop-native.mjs --check",
    "desktop:test": "node scripts/desktop-native.mjs --test",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:native": "node scripts/desktop-native.mjs --run native-only",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop:icons": "node scripts/build-desktop.mjs --icons",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "assets:sync": "node scripts/sync-bevy-assets.mjs",
    "build:bevy": "node scripts/build-bevy-wasm.mjs",
    "build:bevy:dev": "node scripts/build-bevy-wasm.mjs --debug --skip-opt",
    "build:renderer": "node scripts/build-model-renderer.mjs",
    "build:renderer:debug": "node scripts/build-model-renderer.mjs --debug",
    "build:recorder": "node scripts/build-shot-recorder.mjs",
    "build:recorder:debug": "node scripts/build-shot-recorder.mjs --debug",
    "recorder:probe": "node scripts/build-shot-recorder.mjs --debug --probe",
    "theme:generate": "node scripts/generate-theme-tokens.mjs",
    "theme:check": "node scripts/generate-theme-tokens.mjs --check",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/build-bevy-wasm.mjs --keep-names && node scripts/build-image-editor-wasm.mjs --keep-names && pnpm -C web --filter @woohaa3/frontend dev",
    "build": "node scripts/ensure-photocraft-wasm.mjs && pnpm run build:wasm && pnpm -C web run build:units && pnpm -C web --filter @woohaa3/frontend build && pnpm run build:browser && pnpm run assemble:extensions",
    "preview": "pnpm run build && node scripts/serve-web.mjs",
    "dev:services": "pnpm run assets:sync && pnpm -C web run build:units && node scripts/dev-orchestrator.mjs",
    "services:build": "pnpm -C web run build:units",
    "prepare": "node scripts/sync-bevy-assets.mjs && node scripts/photocraft.mjs setup",
    "ui": "pnpm -C web/showcase dev",
    "ui:build": "pnpm -C web/showcase build",
    "test": "pnpm -C web run test",
    "typecheck": "pnpm -C web run typecheck",
    "perf:check": "node scripts/check-frontend-budget.mjs",
    "build:browser": "pnpm -C web run build:browser",
    "extensions:check": "node scripts/extensions-preflight.mjs",
    "assemble:extensions": "node scripts/assemble-extension-release.mjs",
    "dev:extensions": "pnpm -C web run dev:extensions",
    "dev:web": "node scripts/dev.mjs",
    "desktop:release": "node scripts/release-desktop.mjs",
    "desktop:host:check": "node scripts/verify-desktop-host.mjs",
    "boundary:check": "node scripts/check-public-boundary.mjs",
    "test:scripts": "node --test scripts/*.test.mjs scripts/lib/*.test.mjs",
    "build:image-editor": "node scripts/build-image-editor-wasm.mjs",
    "build:wasm": "node scripts/build-bevy-wasm.mjs && node scripts/build-image-editor-wasm.mjs",
    "photocraft:install": "node scripts/photocraft.mjs install",
    "photocraft:setup": "node scripts/photocraft.mjs setup",
    "photocraft:check": "node scripts/photocraft.mjs check",
    "photocraft:dev": "node scripts/photocraft.mjs dev",
    "photocraft:wasm": "node scripts/photocraft.mjs wasm",
    "photocraft:verifier": "node scripts/photocraft.mjs verifier"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  },
  "packageManager": "pnpm@11.17.0"
}
